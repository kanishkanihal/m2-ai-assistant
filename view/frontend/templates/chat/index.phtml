<?php
/**
 * AI Shopping Assistant — Chat page template
 *
 * @var \Kanishka\AiAssistant\Block\Chat\Index $block
 */
$customerName = $block->escapeHtml($block->getCustomerFirstname());
$formKey      = $block->escapeHtml($block->getFormKey());
?>
<div class="ai-chat-page"
     id="ai-chat-page"
     data-customer-name="<?= $customerName ?>"
     data-form-key="<?= $formKey ?>"
     data-chat-url="<?= $block->escapeUrl($block->getRestChatUrl()) ?>"
     data-product-info-url="<?= $block->escapeUrl($block->getUrl('ai-assistant/ajax/productinfo')) ?>"
     data-product-options-url="<?= $block->escapeUrl($block->getUrl('ai-assistant/ajax/productoptions')) ?>"
     data-add-to-cart-url="<?= $block->escapeUrl($block->getUrl('ai-assistant/ajax/addtocart')) ?>"
     data-addresses-url="<?= $block->escapeUrl($block->getUrl('ai-assistant/ajax/addresses')) ?>"
     data-set-address-url="<?= $block->escapeUrl($block->getUrl('ai-assistant/ajax/setaddress')) ?>"
     data-set-shipping-method-url="<?= $block->escapeUrl($block->getUrl('ai-assistant/ajax/setshippingmethod')) ?>"
     data-remove-item-url="<?= $block->escapeUrl($block->getUrl('checkout/sidebar/removeItem')) ?>"
     data-checkout-url="<?= $block->escapeUrl($block->getUrl('checkout')) ?>">

    <div class="ai-chat-messages" id="ai-chat-messages">
        <!-- Messages injected by ai-chat.js -->
    </div>

