            <button type="submit"
                    class="ai-chat-send-btn action primary"
                    id="ai-chat-send"
                    aria-label="<?= $block->escapeHtmlAttr(__('Send message')) ?>">
                <span><?= $block->escapeHtml(__('Send')) ?></span>
            </button>
        </form>
    </div>
